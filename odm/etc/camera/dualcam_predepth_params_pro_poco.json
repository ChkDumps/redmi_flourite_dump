{
  "//": "Global parameters",
  "StructGlobal": {
    "StructMask": {
      "paramSwitch": 2,
      "paramaiMaskDownSample": 4,
      "parammImaskW": 960,
      "parammImaskH": 720,
      "paramDetModel": "human_detect",
      "paramSegModel": "portrait_blur"
    },
    "StructAiDepth": {
      "paramSwitch": 1,
      "paramDepthW": 1024
    },
    "StructAideploy": {
      "paramPlatform": 0
    },
    "paramDepthMode": 1,
    "StructDenseNN": {
      "paramSwitch": 1,
      "paramDeploySwitchA": 0,
      "paramDeploySwitchB": 1,
      "paramDeploySwitchC": 1,
      "paramDeploySwitchD": 1,
      "paramSpDispScale": 4.0,
      "StructModel1": {
        "paramVer": "6.22",
        "paramDepthW": 1024,
        "paramDepthH": 768
      },
      "StructModel2": {
        "paramVer": "8.14",
        "paramDepthW": 512,
        "paramDepthH": 512
      }
    },
    "StructNNStereo": {
      "StructModelStereo": {
        "paramVer": "0_0901_33",
        "paramInputW": 512,
        "paramInputH": 384
      },
      "StructModelRefine": {
        "paramVer": "1_0901_33",
        "paramInputW": 1024,
        "paramInputH": 768
      }
    },
    "StructMultiThread": {
      "paramMaskThreadSwitch": 0,
      "paramBgFilterSwitch": 0,
      "paramAiDepthThreadSwitch": 0
    },
    "StructDspGpu": {
      "paramBmDspSwitch": 1,
      "paramMatteGpuSwitch": 1
    },
    "paramIsTrustAfCode": 1
  },
  "///": "det parameters",
  "det_param": {
      "Loader_param": {
          "model_file_name": "human_det_quant_npu_320.minn"
      },
      "PreProcess": {
          "inputs": [
              {
                  "name": "input",
                  "shape": [1, 320, 320, 3]
              }
          ],
          "outputs": [
              {
                  "name": "1102",
                  "layer": "Sigmoid_250",
                  "shape": [1, 40, 40, 1]
              },
              {
                  "name": "1103",
                  "layer": "Sigmoid_251",
                  "shape": [1, 20, 20, 1]
              },
              {
                  "name": "1104",
                  "layer": "Sigmoid_252",
                  "shape": [1, 10, 10, 1]
              },
              {
                  "name": "1105",
                  "layer": "Sigmoid_253",
                  "shape": [1, 5, 5, 1]
              },
              {
                  "name": "1130",
                  "layer": "Concat_275",
                  "shape": [1, 40, 40, 32]
              },
              {
                  "name": "1155",
                  "layer": "Concat_297",
                  "shape": [1, 20, 20, 32]
              },
              {
                  "name": "1180",
                  "layer": "Concat_319",
                  "shape": [1, 10, 10, 32]
              },
              {
                  "name": "1205",
                  "layer": "Concat_341",
                  "shape": [1, 5, 5, 32]
              }
          ],
          "resize_keep_ratio": true,
          "image_mean": [
              0.0,
              0.0,
              0.0
          ],
          "image_std": [
              255.0,
              255.0,
              255.0
          ],
          "inputimage_format": "rgb"
      },
      "PostProcessList": {
              "param": {
                  "anchor_generator": {
                      "anchor_strides": [
                          8,
                          16,
                          32,
                          64
                      ]
                  },
                  "anchor_head": {
                      "cls_output_name": [
                          "1102",
                          "1103",
                          "1104",
                          "1105"
                      ],
                      "reg_output_name": [
                          "1130",
                          "1155",
                          "1180",
                          "1205"
                      ],
                      "use_sigmoid_cls": true,
                      "iou_thr": 0.4,
                      "score_thr": 0.4,
                      "num_class": 2
                  }
              }
          }
  },
  "////": "seg parameters",
  "seg_param": {
	  "useTrimap": false,
      "Loader_param": {
          "model_file_name": "human_seg_bimap_quant_npu_768.minn",
		  "model_file_name_trimap": "human_seg_trimap_quant_npu_768.minn"
      },
      "PreProcess": {
          "inputs": [
              {
                  "name": "input",
                  "shape": [1, 768, 768, 3]
              }
          ],
          "outputs": [
              {
                  "name": "output",
                  "shape": [1, 768, 768, 1]
              },
              {
                  "name": "output_matting",
                  "shape": [1, 768, 768, 1]
              },
              {
                  "name": "output_trimap",
                  "shape": [1, 768, 768, 3]
              }
          ],
          "resize_keep_ratio": true,
          "image_mean": [
              0.0,
              0.0,
              0.0
          ],
          "image_std": [
              1.0,
              1.0,
              1.0
          ],
          "inputimage_format": "bgr"
      },
      "PostProcessList": {
        "param": {
              "logit_map": true,
              "output_channel": 0,
              "scaler": 255,
              "tensor_in": "output"
        },
	    "trimap_param_0": {
            "logit_map": true,
            "output_channel": 0,
            "scaler": 255,
            "tensor_in": "output_matting"
        },
		"trimap_param_1": {
            "logit_map": true,
            "output_channel": 0,
            "scaler": 127,
            "tensor_in": "output_trimap"
        }
      }
  }
}