/dts-v1/;

/ {
	qcom,pmic-id-size = <0x08>;
	qcom,pmic-id = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x4c>;
	model = "Qualcomm Technologies, Inc. Flourite based on SM7635";
	compatible = "qcom,volcano-mtp", "qcom,volcano", "qcom,volcanop-mtp", "qcom,volcanop", "qcom,mtp";
	qcom,msm-id = <0x291 0x10000 0x292 0x10000>;
	qcom,board-id = <0x08 0x00>;
	xiaomi,miboard-id = <0x0e 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pmxr2230-bcl-lvl0 {

				cooling-maps {

					vph_cdsp0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x02 0x02>;
					};

					vph_gpu0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x02 0x02>;
					};

					vph_modem0_0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x08 0x08>;
					};

					vph_modem0_1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x06 0x06>;
					};

					vph_modem0_2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x03 0x03>;
					};
				};
			};

			pmxr2230-bcl-lvl1 {

				cooling-maps {

					vph_gpu1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x03 0x03>;
					};

					vph_cdsp1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x04 0x04>;
					};

					vph_modem1_0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x0a 0x0a>;
					};

					vph_modem1_1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x09 0x09>;
					};

					vph_modem1_2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x0a 0x0a>;
					};
				};
			};

			pmxr2230-bcl-lvl2 {

				cooling-maps {

					vph_cdsp2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x07 0x07>;
					};

					vph_gpu2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x07 0x07>;
					};
				};
			};

			pm8550vs_c_tz {

				cooling-maps {

					pm8550vs_c_lte {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0xff 0xff>;
					};

					pm8550vs_c_apc1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};
				};
			};

			pmxr2230_tz {

				cooling-maps {

					pmxr2230_gpu {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x05 0xffffffff>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-crow";
			vdda-phy-supply = <0xffffffff>;
			vdda-phy-max-microamp = <0x22358>;
			vdda-pll-supply = <0xffffffff>;
			vdda-pll-max-microamp = <0x47a4>;
			vdd-phy-gdsc-supply = <0xffffffff>;
			vdda-qref-supply = <0xffffffff>;
			vdda-qref-max-microamp = <0x906>;
			status = "ok";
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-hba-supply = <0xffffffff>;
			vcc-supply = <0xffffffff>;
			vcc-max-microamp = "", "\f5";
			vccq-supply = <0xffffffff>;
			vccq-max-microamp = <0xb71b0>;
			vccq2-supply = <0xffffffff>;
			vccq2-max-microamp = <0xb71b0>;
			qcom,vddp-ref-clk-supply = <0xffffffff>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vccq-parent-supply = <0xffffffff>;
			qcom,vccq-parent-max-microamp = <0x33450>;
			status = "ok";
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			status = "disabled";
			vdd-supply = <0xffffffff>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <0xffffffff>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0xffffffff>;
			pinctrl-1 = <0xffffffff>;
			cd-gpios = <0xffffffff 0x41 0x01>;
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			qcom,i2c-touch-active = "focaltech,fts_ts";

			focaltech@38 {
				compatible = "focaltech,fts_ts";
				reg = <0x38>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x13 0x2008>;
				focaltech,reset-gpio = <0xffffffff 0x14 0x00>;
				focaltech,irq-gpio = <0xffffffff 0x13 0x2008>;
				focaltech,display-coords = <0x00 0x00 0x438 0x968>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,ic-type = <0x8726081c>;
				focaltech,touch-type = "primary";
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff 0xffffffff>;
				pinctrl-2 = <0xffffffff>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			dump_display_region@816e0000 {
				compatible = "xiaomi,dump_display";
				reg = <0x816e0000 0x800>;
				phandle = <0x3d>;
			};

			mtdoops_pmsg@0xa7000000 {
				compatible = "xiaomi,mtdoops_pmsg";
				reg = <0xa7000000 0x400000>;
				console-size = <0x200000>;
				pmsg-size = <0x200000>;
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm7550ba@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0xffffffff 0x703>;
					io-channel-names = "thermal";
					phandle = <0x01>;
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					phandle = <0x3e>;
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					phandle = <0x3f>;
				};

				sdam@7200 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7200>;
					phandle = <0x40>;
				};

				sdam@7300 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7300>;
					phandle = <0x41>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm7550ba-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x42>;

					sys_therm_7_gpio6 {

						sys_therm_7_gpio6_default {
							pins = "gpio6";
							bias-high-impedance;
							phandle = <0x04>;
						};
					};

					charger_therm_gpio6 {

						charger_therm_gpio6_default {
							pins = "gpio6";
							bias-high-impedance;
							phandle = <0x38>;
						};
					};

					wifi_therm_gpio3 {

						wifi_therm_gpio3_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x39>;
						};
					};

					conn_therm2_gpio2 {

						conn_therm2_gpio2_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x3a>;
						};
					};

					therm_gpio4 {

						therm_gpio4_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x3c>;
						};
					};
				};

				eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					status = "ok";
					vdd18-supply = <0xffffffff>;
					vdd3-supply = <0xffffffff>;
					qcom,param-override-seq = <0x00 0x50 0x09 0x51 0x01 0x52 0x07 0x53 0x01 0x54 0x02 0x55 0x00 0x56 0x05 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					qcom,param-override-seq-host-ms = <0x00 0x50 0x0e 0x51 0x01 0x52 0x07 0x53 0x01 0x54 0x00 0x55 0x00 0x56 0x00 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					qcom,param-override-seq-host = <0x00 0x50 0x0e 0x51 0x01 0x52 0x07 0x53 0x01 0x54 0x03 0x55 0x00 0x56 0x07 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					phandle = <0x08>;
				};

				qcom,vibrator@df00 {
					compatible = "qcom,qpnp-vibrator-ldo";
					reg = <0xdf00>;
					qcom,vib-ldo-volt-uv = <0x2dc6c0>;
					qcom,disable-overdrive;
					status = "okay";
					phandle = <0x43>;
				};

				qcom,amoled {
					compatible = "qcom,qpnp-amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					status = "okay";
					phandle = <0x44>;

					oledb@fa00 {
						reg = <0xfa00>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x7a1200>;
						qcom,swire-control;
						phandle = <0x45>;
					};

					ab@f900 {
						reg = <0xf900>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x4630c0>;
						regulator-max-microvolt = <0x4f5880>;
						qcom,swire-control;
						phandle = <0x46>;
					};

					ibb@f800 {
						reg = <0xf800>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = <0x155cc0>;
						regulator-max-microvolt = <0x64b540>;
						qcom,swire-control;
						regulator-allow-set-load;
						phandle = <0x47>;
					};
				};

				qcom,amoled-ecm@f900 {
					compatible = "qcom,amoled-ecm";
					reg = <0xf900>;
					status = "disabled";
					nvmem-names = "amoled-ecm-sdam0", "amoled-ecm-sdam1", "amoled-ecm-sdam2";
					nvmem = <0xffffffff 0xffffffff 0xffffffff>;
					interrupt-names = "ecm-sdam0", "ecm-sdam1", "ecm-sdam2";
					interrupts = <0x00 0x7c 0x01 0x01 0x00 0x7d 0x01 0x01 0x00 0x98 0x01 0x01>;
					phandle = <0x48>;
				};

				bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x07 0x47 0x00 0x00 0x07 0x47 0x01 0x00 0x07 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					nvmem-cells = <0xffffffff>;
					nvmem-cell-names = "smb1510_present";
					phandle = <0x02>;
				};

				bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x03>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			pm7550ba_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x01>;
				phandle = <0x49>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x4a>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x4b>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x4c>;
					};
				};
			};

			pm7550ba-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x02 0x00>;

				trips {

					ibat-lvl0 {
						temperature = <0x1b58>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x4d>;
					};
				};
			};

			pm7550ba-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x02 0x01>;

				trips {

					ibat-lvl1 {
						temperature = <0x2328>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x4e>;
					};
				};
			};

			pm7550ba-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x02 0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x05>;
					};
				};
			};

			pm7550ba-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x02 0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x06>;
					};
				};
			};

			pm7550ba-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x02 0x07>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x07>;
					};
				};
			};

			socd {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x03>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pm7550ba-debug@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
				qcom,can-sleep;
			};
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {

			spmi@0 {
				reg = <0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,pm7550ba-debug@7 {
					compatible = "qcom,spmi-pmic";
					reg = <0x07 0x00>;
					qcom,can-sleep;
				};
			};

			i2c@106 {
				reg = <0x106>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				qcom,bus-type = "i2c";

				qcom,smb1500@6b {
					compatible = "qcom,i2c-pmic";
					reg = <0x6b>;
					qcom,can-sleep;
				};
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-0 = <0x04>;
			pinctrl-names = "default";

			pm7550ba_offset_ref {
				reg = <0x700>;
				label = "pm7550ba_offset_ref";
				qcom,pre-scaling = <0x01 0x01>;
			};

			pm7550ba_vref_1p25 {
				reg = <0x701>;
				label = "pm7550ba_vref_1p25";
				qcom,pre-scaling = <0x01 0x01>;
			};

			pm7550ba_die_temp {
				reg = <0x703>;
				label = "pm7550ba_die_temp";
				qcom,pre-scaling = <0x01 0x01>;
			};

			pm7550ba_vph_pwr {
				reg = <0x78e>;
				label = "pm7550ba_vph_pwr";
				qcom,pre-scaling = <0x01 0x03>;
			};

			pm7550ba_chg_temp {
				reg = <0x710>;
				label = "pm7550ba_chg_temp";
			};

			pm7550ba_iin_fb {
				reg = <0x717>;
				label = "pm7550ba_iin_fb";
			};

			pm7550ba_ichg_fb {
				reg = <0x7a1>;
				label = "pm7550ba_ichg_fb";
			};

			pm7550ba_batt_therm {
				reg = <0x744>;
				label = "pm7550ba_batt_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,scale-fn-type = <0x17>;
			};
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {

			pm7550ba-bcl-lvl0 {

				cooling-maps {

					lbat_gpu0 {
						trip = <0x05>;
						cooling-device = <0xffffffff 0x02 0x02>;
					};

					lbat_cdsp0 {
						trip = <0x05>;
						cooling-device = <0xffffffff 0x02 0x02>;
					};

					lbat_modem0_0 {
						trip = <0x05>;
						cooling-device = <0xffffffff 0x08 0x08>;
					};

					lbat_modem0_1 {
						trip = <0x05>;
						cooling-device = <0xffffffff 0x06 0x06>;
					};

					lbat_modem0_2 {
						trip = <0x05>;
						cooling-device = <0xffffffff 0x03 0x03>;
					};
				};
			};

			pm7550ba-bcl-lvl1 {

				cooling-maps {

					lbat_gpu1 {
						trip = <0x06>;
						cooling-device = <0xffffffff 0x03 0x03>;
					};

					lbat_cdsp1 {
						trip = <0x06>;
						cooling-device = <0xffffffff 0x04 0x04>;
					};

					lbat_modem1_0 {
						trip = <0x06>;
						cooling-device = <0xffffffff 0x0a 0x0a>;
					};

					lbat_modem1_1 {
						trip = <0x06>;
						cooling-device = <0xffffffff 0x09 0x09>;
					};

					lbat_modem1_2 {
						trip = <0x06>;
						cooling-device = <0xffffffff 0x0a 0x0a>;
					};
				};
			};

			pm7550ba-bcl-lvl2 {

				cooling-maps {

					lbat_cdsp2 {
						trip = <0x07>;
						cooling-device = <0xffffffff 0x07 0x07>;
					};

					lbat_gpu2 {
						trip = <0x07>;
						cooling-device = <0xffffffff 0x07 0x07>;
					};
				};
			};
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			dummy-supply = <0x08>;
			usb-repeater = <0x08>;
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			xiaomi_fingerprint {
				compatible = "xiaomi,xiaomi-fp";
				xiaomi,gpio_irq = <0xffffffff 0x4b 0x00>;
				fp_goodix-supply = <0xffffffff>;
				netlink-event = <0x19>;
