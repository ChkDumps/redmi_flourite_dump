				interconnects = <0xffffffff 0x21 0xffffffff 0x239 0xffffffff 0x02 0xffffffff 0x219 0xffffffff 0x07 0xffffffff 0x200>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <0x0c 0x0d>;
				pinctrl-1 = <0x0e>;
