	fragment@114 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,smp2p-wpss {

				qcom,smp2p-wlan-1-in {
					phandle = <0x19c>;
					#interrupt-cells = <0x02>;
					interrupt-controller;
					qcom,entry-name = "wlan";
				};

				qcom,smp2p-wlan-1-out {
					phandle = <0x199>;
					#qcom,smem-state-cells = <0x01>;
					qcom,entry-name = "wlan";
				};

				qcom,smp2p-wlan-2-in {
					phandle = <0x19d>;
					#interrupt-cells = <0x02>;
					interrupt-controller;
					qcom,entry-name = "wlan_soc_wake";
				};

				qcom,smp2p-wlan-2-out {
					phandle = <0x19a>;
					#qcom,smem-state-cells = <0x01>;
					qcom,entry-name = "wlan_soc_wake";
				};

				qcom,smp2p-wlan-3-out {
					phandle = <0x19b>;
					#qcom,smem-state-cells = <0x01>;
					qcom,entry-name = "wlan_ep_power_save";
				};
			};

			qcom,wcn6750 {
				phandle = <0x19e>;
				qcom,vreg_ol_cpr = "s3b";
				qcom,qmp = <0xffffffff>;
				qcom,smem-state-names = "wlan-smp2p-out", "wlan-soc-wake-smp2p-out", "wlan-ep-powersave-smp2p-out";
